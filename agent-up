#!/usr/bin/env bash
set -uo pipefail

VERSION="1.0.0"

# Ensure common user CLI paths are available even in non-interactive/SSH shells
export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:$HOME/.grok/bin:$HOME/.gemini/antigravity-cli/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

DEFAULT_AGENTS=("codex" "claude" "grok" "agy")

usage() {
  cat <<EOF
agent-up v${VERSION}
Update AI coding CLI agents in parallel.

Usage:
  agent-up [AGENTS...]
  agent-up [-h|--help] [-v|--version]

Default agents:
  codex, claude, grok, agy

Examples:
  agent-up                # Run codex/claude/grok/agy update in parallel
  agent-up codex claude   # Update only specified agents in parallel
EOF
}

AGENTS=()
for arg in "$@"; do
  case "$arg" in
    -h|--help)
      usage
      exit 0
      ;;
    -v|-V|--version)
      echo "agent-up ${VERSION}"
      exit 0
      ;;
    -*)
      echo "agent-up: unknown option: $arg" >&2
      usage >&2
      exit 2
      ;;
    *)
      AGENTS+=("$arg")
      ;;
  esac
done

if [[ ${#AGENTS[@]} -eq 0 ]]; then
  AGENTS=("${DEFAULT_AGENTS[@]}")
fi

if [[ -t 1 ]]; then
  C_RESET=$'\033[0m'
  C_BOLD=$'\033[1m'
  C_GREEN=$'\033[32m'
  C_RED=$'\033[31m'
  C_YELLOW=$'\033[33m'
  PALETTE=(
    $'\033[36m' # cyan
    $'\033[35m' # purple
    $'\033[33m' # yellow
    $'\033[34m' # blue
    $'\033[32m' # green
  )
else
  C_RESET=""
  C_BOLD=""
  C_GREEN=""
  C_RED=""
  C_YELLOW=""
  PALETTE=("")
fi

color_for_index() {
  local idx="$1"
  local count="${#PALETTE[@]}"
  echo "${PALETTE[$((idx % count))]}"
}

TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/agent-up.XXXXXX")"
PIDS=()

cleanup() {
  for pid in "${PIDS[@]:-}"; do
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      pkill -P "$pid" 2>/dev/null || true
      kill "$pid" 2>/dev/null || true
    fi
  done
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

run_agent_update() {
  local name="$1"
  local color="$2"
  local rc_file="$TMP_DIR/${name}.rc"

  if ! command -v "$name" >/dev/null 2>&1; then
    printf "%s[%-6s]%s %sskipped (not installed)%s\n" "$color" "$name" "$C_RESET" "$C_YELLOW" "$C_RESET"
    echo 127 >"$rc_file"
    return 0
  fi

  printf "%s[%-6s]%s starting '%s update'...\n" "$color" "$name" "$C_RESET" "$name"

  (
    set -o pipefail
    "$name" update </dev/null 2>&1 | while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%$'\r'}"
      line="${line##*$'\r'}"
      [[ -z "$line" ]] && continue
      printf "%s[%-6s]%s %s\n" "$color" "$name" "$C_RESET" "$line"
    done
  )
  local rc=$?
  echo "$rc" >"$rc_file"

  if [[ $rc -eq 0 ]]; then
    printf "%s[%-6s]%s %sdone%s\n" "$color" "$name" "$C_RESET" "$C_GREEN" "$C_RESET"
  else
    printf "%s[%-6s]%s %sfailed (exit %d)%s\n" "$color" "$name" "$C_RESET" "$C_RED" "$rc" "$C_RESET"
  fi
}

printf "%s==> Updating %d agent(s) in parallel: %s%s\n" "$C_BOLD" "${#AGENTS[@]}" "${AGENTS[*]}" "$C_RESET"

for i in "${!AGENTS[@]}"; do
  run_agent_update "${AGENTS[$i]}" "$(color_for_index "$i")" &
  PIDS+=("$!")
done

for pid in "${PIDS[@]}"; do
  wait "$pid" 2>/dev/null || true
done

echo ""
printf "%s==> Summary%s\n" "$C_BOLD" "$C_RESET"

OVERALL_RC=0
INSTALLED_COUNT=0

for i in "${!AGENTS[@]}"; do
  name="${AGENTS[$i]}"
  color="$(color_for_index "$i")"
  rc_file="$TMP_DIR/${name}.rc"
  rc=1
  [[ -f "$rc_file" ]] && rc="$(cat "$rc_file")"

  ver=""
  if command -v "$name" >/dev/null 2>&1; then
    ver="$("$name" --version </dev/null 2>/dev/null | head -n 1 | tr -d '\r' || true)"
  fi

  if [[ "$rc" -eq 0 ]]; then
    INSTALLED_COUNT=$((INSTALLED_COUNT + 1))
    printf "  %s✓%s %s%-6s%s  updated  %s\n" "$C_GREEN" "$C_RESET" "$color" "$name" "$C_RESET" "${ver:+($ver)}"
  elif [[ "$rc" -eq 127 ]]; then
    printf "  %s-%s %s%-6s%s  skipped (not installed)\n" "$C_YELLOW" "$C_RESET" "$color" "$name" "$C_RESET"
  else
    INSTALLED_COUNT=$((INSTALLED_COUNT + 1))
    printf "  %s✗%s %s%-6s%s  failed (exit %s)  %s\n" "$C_RED" "$C_RESET" "$color" "$name" "$C_RESET" "$rc" "${ver:+($ver)}"
    OVERALL_RC=1
  fi
done

if [[ "$INSTALLED_COUNT" -eq 0 ]]; then
  OVERALL_RC=1
fi

exit "$OVERALL_RC"
